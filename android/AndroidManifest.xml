<?xml version="1.0" encoding="utf-8"?>
<!-- PIXA SHARE — the real Android app (no browser dependency).
     A full-screen WebView shell around the PIXA SHARE app with:
     - own launcher icon + name (the Picasa colour wheel)
     - Gallery -> Share -> PIXA SHARE native intent filters
     - <input type=file> wired to the Android photo picker
     - a tiny JS bridge that hands shared photos to the page queue
     Pure android.app / android.webkit — no AndroidX, no Gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shivam.pixashare"
    android:versionCode="11"
    android:versionName="1.4.6">

  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.INTERNET"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:hardwareAccelerated="true"
      android:allowBackup="true"
      android:usesCleartextTraffic="false">

    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden"
        android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- Gallery -> Share -> PIXA SHARE (one photo) -->
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
      <!-- Gallery -> Share -> PIXA SHARE (many photos) -->
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="image/*"/>
      </intent-filter>
      <!-- Google sign-in comes back from the phone's browser through
           this deep link (oauth.html redirects to pixashare://oauth#…) -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="pixashare" android:host="oauth"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
